[Unit]
Description=EV Smart Charger (maincamera.py)
After=network.target

[Service]
Type=simple
User=notathip
Group=notathip
WorkingDirectory=/home/notathip/ev_charger
Environment=EV_PORT=80
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do pgrep -x pigpiod >/dev/null && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/bin/python3 -u RaspberryPI/maincamera.py
KillSignal=SIGINT
TimeoutStopSec=15
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
